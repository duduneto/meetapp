generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssignmentResponseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ParticipationNotificationStatus {
  PENDING
  SENT
  FAILED
}

model Congregation {
  id                      String                @id @default(cuid())
  name                    String
  sanitizedName           String                @default("")
  userId                  String?
  deletedAt               DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  settings                CongregationSettings?
  users                   User[]
  participants            Participant[]
  meetingWeeks            MeetingWeek[]
  auditLogs               AuditLog[]
  publicAccessTokens      PublicAccessToken[]
  createdBy               User?                 @relation("CongregationCreatedBy", fields: [userId], references: [id], onDelete: SetNull)
  homePublicSpeakers      PublicSpeaker[]       @relation("PublicSpeakerHomeCongregation")
  hostedPublicSpeakers    PublicSpeaker[]       @relation("PublicSpeakerHostCongregation")

  @@index([deletedAt])
  @@index([sanitizedName])
}

model CongregationSettings {
  id                          String       @id @default(cuid())
  congregationId              String       @unique
  timezone                    String       @default("America/Fortaleza")
  midweekDefaultWeekday       Int          @default(3)
  weekendDefaultWeekday       Int          @default(6)
  anonymousReadTokenHash      String
  anonymousReadTokenCreatedAt DateTime     @default(now())
  scriptApiKeyHash            String
  scriptApiKeyCreatedAt       DateTime     @default(now())
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  congregation                Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
}

model User {
  id                            String                       @id @default(cuid())
  congregationId                String
  firebaseUid                   String?                      @unique
  email                         String
  name                          String
  role                          String
  active                        Boolean                      @default(true)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  congregation                  Congregation                 @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  auditLogs                     AuditLog[]
  createdPublicAccessTokens     PublicAccessToken[]          @relation("PublicAccessTokenCreatedBy")
  participationNotifications    ParticipationNotification[]
  createdCongregations          Congregation[]               @relation("CongregationCreatedBy")
  createdPublicSpeakThemes      PublicSpeakTheme[]           @relation("PublicSpeakThemeCreatedBy")
  createdPublicSpeakers         PublicSpeaker[]              @relation("PublicSpeakerCreatedBy")

  @@unique([congregationId, email])
  @@index([email])
}

model PublicAccessToken {
  id              String       @id @default(cuid())
  congregationId  String
  name            String
  accessCode      String?      @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  isDefault       Boolean      @default(false)
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  congregation    Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  createdByUser   User?        @relation("PublicAccessTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([congregationId, createdAt])
  @@index([congregationId, isDefault, revokedAt, expiresAt])
}

model Participant {
  id             String       @id @default(cuid())
  congregationId String
  name           String
  gender         String?
  phone          String?
  whatsapp       String?
  /// Allow-list of preferred meetings/sections/roles. null = unrestricted.
  preferences    Json?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  assignments    Assignment[]
  auditLogs      AuditLog[]   @relation("ParticipantAuditLogs")

  @@index([congregationId, deletedAt])
}

model PublicSpeakTheme {
  id                 String       @id @default(cuid())
  number             Int
  title              String
  fullTitle          String
  sanitizedFullTitle String
  documentId         String?
  path               String?
  userId             String?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          User?        @relation("PublicSpeakThemeCreatedBy", fields: [userId], references: [id], onDelete: SetNull)
  assignments        Assignment[]

  @@unique([number])
  @@index([sanitizedFullTitle])
  @@index([deletedAt])
}

model PublicSpeaker {
  id                 String       @id @default(cuid())
  name               String
  sanitizedName      String
  congregationId     String
  hostCongregationId String
  phone              String
  whatsapp           String
  userId             String?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  congregation       Congregation @relation("PublicSpeakerHomeCongregation", fields: [congregationId], references: [id])
  hostCongregation   Congregation @relation("PublicSpeakerHostCongregation", fields: [hostCongregationId], references: [id], onDelete: Cascade)
  createdBy          User?        @relation("PublicSpeakerCreatedBy", fields: [userId], references: [id], onDelete: SetNull)
  assignments        Assignment[]

  @@index([hostCongregationId, deletedAt])
  @@index([sanitizedName])
}

model MeetingWeek {
  id               String       @id @default(cuid())
  congregationId   String
  ref              String
  year             Int
  month            Int
  yearWeek         Int
  startAt          DateTime
  endAt            DateTime
  bibleReading     String?
  rawSourcePayload Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  congregation     Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  meetings         Meeting[]

  @@unique([congregationId, ref])
  @@unique([congregationId, year, yearWeek])
  @@index([congregationId, startAt])
}

model Meeting {
  id                        String           @id @default(cuid())
  meetingWeekId             String
  type                      String
  meetingDate               DateTime?
  initialSong               String?
  publicTalkTheme           String?
  publicSpeakerName         String?
  publicSpeakerCongregation String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  meetingWeek               MeetingWeek      @relation(fields: [meetingWeekId], references: [id], onDelete: Cascade)
  sections                  MeetingSection[]
  auditLogs                 AuditLog[]

  @@unique([meetingWeekId, type])
}

model MeetingSection {
  id         String        @id @default(cuid())
  meetingId  String
  sectionKey String
  title      String
  order      Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  meeting    Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  parts      MeetingPart[]

  @@unique([meetingId, sectionKey])
  @@index([meetingId, order])
}

model MeetingPart {
  id               String            @id @default(cuid())
  meetingSectionId String
  partKey          String
  title            String
  order            Int
  assignable       Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  meetingSection   MeetingSection    @relation(fields: [meetingSectionId], references: [id], onDelete: Cascade)
  slots            MeetingPartSlot[]

  @@unique([meetingSectionId, partKey])
  @@index([meetingSectionId, order])
}

model MeetingPartSlot {
  id            String      @id @default(cuid())
  meetingPartId String
  position      Int
  label         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  meetingPart   MeetingPart @relation(fields: [meetingPartId], references: [id], onDelete: Cascade)
  assignment    Assignment?

  @@unique([meetingPartId, position])
}

model Assignment {
  id                          String                   @id @default(cuid())
  meetingPartSlotId           String                   @unique
  participantId               String?
  publicSpeakerId             String?
  publicSpeakThemeId          String?
  responseStatus              AssignmentResponseStatus @default(PENDING)
  respondedAt                 DateTime?
  participationTokenVersion   Int                      @default(0)
  participationTokenIssuedAt  DateTime?
  participationAccessCodeHash String?                  @unique
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  meetingPartSlot             MeetingPartSlot          @relation(fields: [meetingPartSlotId], references: [id], onDelete: Cascade)
  participant                 Participant?             @relation(fields: [participantId], references: [id])
  publicSpeaker               PublicSpeaker?           @relation(fields: [publicSpeakerId], references: [id])
  publicSpeakTheme            PublicSpeakTheme?        @relation(fields: [publicSpeakThemeId], references: [id])
  participationNotifications  ParticipationNotification[]

  @@index([publicSpeakerId])
  @@index([publicSpeakThemeId])
}

model ParticipationNotification {
  id                String                          @id @default(cuid())
  assignmentId      String
  createdByUserId   String?
  batchId           String
  tokenVersion      Int
  recipientWhatsapp String
  status            ParticipationNotificationStatus @default(PENDING)
  error             String?
  providerMessageId String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  sentAt            DateTime?
  assignment        Assignment                      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdByUser     User?                           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, tokenVersion])
  @@index([batchId])
  @@index([assignmentId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id                     String       @id @default(cuid())
  congregationId         String
  meetingId              String?
  changedByUserId        String?
  changedByParticipantId String?
  actorType              String       @default("USER")
  action                 String       @default("UPDATED")
  changedAt              DateTime     @default(now())
  entityType             String
  entityId               String
  field                  String
  previousValue          String?
  newValue               String?
  context                Json?
  congregation           Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  meeting                Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  changedByUser          User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByParticipant   Participant? @relation("ParticipantAuditLogs", fields: [changedByParticipantId], references: [id], onDelete: SetNull)

  @@index([congregationId, changedAt])
  @@index([meetingId, changedAt])
  @@index([entityType, entityId])
}
